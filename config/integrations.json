{
  "pipeline": ["communityRanking", "searchRanking", "socialRanking", "crossChannelOverlap"],
  "providers": {
    "naverDataLab": { "enabledWhenConfigured": false, "role": "disabledByUser", "official": true },
    "googleTrends": { "enabledWhenConfigured": true, "role": "globalSearchTrend", "officialAlpha": true },
    "naverSearch": { "enabledWhenConfigured": false, "role": "disabledByUser", "official": true },
    "youtubeDataApi": { "enabledWhenConfigured": true, "role": "videoDemandAndCompetition", "official": true }
  },
  "expansion": {
    "sources": ["communityTitleNgrams", "crossCommunityCooccurrence", "naverSearchTitles", "youtubeSearchTitles"],
    "maxTermsPerTopic": 15,
    "excludeStopwords": true
  },
  "channelRanking": {
    "windowsHours": [6, 24, 72, 168],
    "minimumSignals": 2,
    "gates": {
      "produceNow": { "communityScoreMin": 65, "searchTrendDeltaMin": 20, "videoOpportunityMin": 60 },
      "watch": { "communityScoreMin": 50 }
    }
  },
  "policy": {
    "channelsHaveIndependentScores": true,
    "crossChannelScoresAreNeverBlended": true,
    "missingExternalDataDoesNotBecomeZero": true,
    "unofficialAutocompleteIsOptional": true
  }
}
